    {
      "id": "binance-por",
      "entity": "Binance",
      "status": "active",
      "cadence": "monthly",
      "fetch": "months",
      "parse": "por_csv",
      "url": "https://public.bnbstatic.com/static/proof-of-reserve/wallet_address_{YYYYMM}01.zip",
      "landing": "https://www.binance.com/en/proof-of-reserves",
      "license": "not stated",
      "evidence_type": "service_disclosure",
      "operator_hosts": [
        "binance.com/",
        "bnbstatic.com/"
      ],
      "options": {
        "from": "2022-11"
      },
      "note": "Monthly reserve archives; a 403 means the month was not published (Nov 2022 to Jan 2023 were not). Lists from February 2025 split into hot/cold and deposit lists."
    },
    {
      "id": "okx-por",
      "entity": "OKX",
      "status": "active",
      "cadence": "monthly",
      "fetch": "page_links",
      "parse": "por_csv",
      "url": "https://www.okx.com/en-gb/proof-of-reserves/download",
      "landing": "https://www.okx.com/en-gb/proof-of-reserves/download",
      "license": "not stated",
      "evidence_type": "service_disclosure",
      "operator_hosts": [
        "okx.com/",
        "twitter.com/okx/"
      ],
      "options": {
        "browser": true,
        "pages": [
          "https://www.okx.com/en-gb/proof-of-reserves/download"
        ],
        "wayback_pages": [
          "www.okx.com/proof-of-reserves/download",
          "www.okx.com/proof-of-reserves"
        ],
        "wayback_prefixes": [
          "static.okx.com/cdn/okx/por/"
        ],
        "link_pattern": "static\\.okx\\.com/cdn/okx/por/(?:chain/)?(?:okx_por|por_csv)_[0-9A-Za-z_]+(?:\\.csv)?\\.zip",
        "date_pattern": "(20\\d{2})(\\d{2})(\\d{2})"
      },
      "note": "File names carry an hour and version that cannot be guessed, so links come from the download page, its Wayback Machine captures and the Wayback index of the file folder. Files OKX no longer serves come from their latest Wayback capture."
    },
